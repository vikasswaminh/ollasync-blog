---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../config';
import { readingTime } from '../utils/posts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: Heading[];
}
const { post, headings = [] } = Astro.props;
const { title, description, pubDate, updatedDate, author = 'The Ollasync team', tags = [], cover } = post.data;
const minutes = readingTime(post.body);
const canonical = new URL(`/blog/${post.slug}/`, Astro.site).href;
const primaryTag = tags[0] || 'Guides';
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author,
    tags,
  }}
>
  <div class="container-nh">
    <div class="nh-layout-wrap">
      
      <!-- Left Sidebar: Featured Guides -->
      <aside class="nh-sidebar">
        <div class="nh-sticky-sidebar">
          <span class="nh-sidebar-pill pill-amber">FEATURED GUIDES</span>
          <nav class="nh-sidebar-nav">
            <a href="/blog/how-to-deploy-an-on-premises-video-conferencing-server/" class="nh-sidebar-link amber-hover">
              Deploy On-Premises Server in 30 Min
            </a>
            <a href="/blog/how-to-host-custom-domain-video-meetings/" class="nh-sidebar-link amber-hover">
              Custom Domain Video Meetings
            </a>
            <a href="/blog/how-to-run-air-gapped-video-conferencing/" class="nh-sidebar-link amber-hover">
              Air-Gapped Video Conferencing
            </a>
            <a href="/blog/getting-started/" class="nh-sidebar-link amber-hover">
              Getting started with OllaSync
            </a>
          </nav>
          <a href="/tags/guides/" class="nh-sidebar-viewall amber">
            View All Guides →
          </a>

          <!-- Platform & Solutions Links from Ollasync -->
          <div style="margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #E5E7EB;">
            <span class="nh-sidebar-pill pill-blue">PLATFORM & SOLUTIONS</span>
            <nav class="nh-sidebar-nav">
              <a href="https://ollasync.com/#for-trainers" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                For Trainers & Coaches
              </a>
              <a href="https://ollasync.com/features/video-meetings" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                Live Video Classrooms
              </a>
              <a href="https://ollasync.com/features/ai" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                AI Voice Translation
              </a>
              <a href="https://ollasync.com/features/deal-rooms" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                Sovereign Deal Rooms
              </a>
              <a href="https://ollasync.com/features/recordings" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                Recording & Archival
              </a>
              <a href="https://ollasync.com/vs" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                Compare vs Zoom & Teams
              </a>
              <a href="https://ollasync.com/pricing" target="_blank" rel="noopener" class="nh-sidebar-link blue-hover">
                Transparent Pricing
              </a>
            </nav>
            <a href="https://ollasync.com" target="_blank" rel="noopener" class="nh-sidebar-viewall blue">
              Explore Ollasync.com →
            </a>
          </div>
        </div>
      </aside>

      <!-- Center Column: Article Content -->
      <main class="nh-main-stream">

        
        <!-- Mobile: Horizontal scroll cards for specials (Exact NH layout) -->
        <div class="nh-mobile-specials">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span class="nh-sidebar-pill pill-amber" style="margin: 0;">FEATURED GUIDES</span>
            </div>
            <div class="nh-mobile-scroll">
              <a href="/blog/getting-started/" class="nh-mobile-card amber">
                Getting started with OllaSync
              </a>
              <a href="/blog/welcome-to-the-blog/" class="nh-mobile-card amber">
                Welcome to the OllaSync Blog
              </a>
              <a href="/tags/guides/" class="nh-mobile-card amber">
                Live Classroom Best Practices
              </a>
            </div>
          </div>
        </div>

        <article class="nh-article-container">
          
          <!-- Breadcrumb -->
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span style="margin: 0 0.4rem;">›</span>
            <a href="/">Blog</a>
            <span style="margin: 0 0.4rem;">›</span>
            <span style="color: #000000; font-weight: 600;">{title}</span>
          </nav>


          <!-- Article Header -->
          <header class="article-header">
            <div class="article-category">
              {primaryTag.toUpperCase()} · OLLASYNC BLOG · {minutes} MIN READ
            </div>
            <h1 class="article-title">{title}</h1>
            <p style="font-size: 1.1rem; color: #4B5563; line-height: 1.6; margin: 0 0 1.25rem;">
              {description}
            </p>
            <div class="article-meta-strip">
              <span>By <strong style="color: #000000;">{author}</strong></span>
              <span>·</span>
              <span>Published <FormattedDate date={pubDate} /></span>
              {
                tags && tags.length > 0 && (
                  <>
                    <span>·</span>
                    <div style="display: inline-flex; gap: 0.35rem;">
                      {tags.map((t) => (
                        <a class="tag" href={`/tags/${t}/`}>#{t}</a>
                      ))}
                    </div>
                  </>
                )
              }
            </div>
          </header>

          <!-- TL;DR Callout Box (Networkers Home Signature) -->
          <section class="tldr-box">
            <p class="tldr-label">TL;DR</p>
            <p class="tldr-text">{description}</p>
          </section>

          {cover && <img class="post-cover" src={cover} alt="" loading="lazy" />}

          <!-- Markdown Content Prose -->
          <div class="prose">
            <slot />
          </div>

          <!-- Bottom Article Callout -->
          <footer style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
            <div>
              <p style="margin: 0; font-size: 0.95rem; font-weight: 700; color: #000000;">
                OllaSync — An AI Classroom for Trainers & Tutors
              </p>
              <p style="margin: 0.2rem 0 0; font-size: 0.85rem; color: #4B5563;">
                Live translation in 10+ languages and automated class notes.
              </p>
            </div>
            <a class="btn-contact" href={SITE.marketingUrl} target="_blank" rel="noopener">
              Start Teaching Free →
            </a>
          </footer>
        </article>
      </main>

      <!-- Right Sidebar: AI & Technical Specials -->
      <aside class="nh-sidebar">
        <div class="nh-sticky-sidebar">
          <span class="nh-sidebar-pill pill-purple">AI SPECIALS</span>
          <nav class="nh-sidebar-nav">
            <a href="/blog/getting-started/" class="nh-sidebar-link purple-hover">
              AI Classroom for Trainers & Tutors
            </a>
            <a href="/blog/welcome-to-the-blog/" class="nh-sidebar-link purple-hover">
              Real-time Voice Translation in 10 Languages
            </a>
            <a href="/tags/announcements/" class="nh-sidebar-link purple-hover">
              Automated AI Class Summaries
            </a>
            <a href="/about/" class="nh-sidebar-link purple-hover">
              Networkers Home & OllaSync Vision
            </a>
          </nav>
          <a href="/tags/announcements/" class="nh-sidebar-viewall purple">
            View All AI Specials →
          </a>

          <!-- Start Free Special CTA Card (24observe adapted) -->
          <div class="nh-sidebar-cta">
            <span class="nh-sidebar-cta-badge">SOVEREIGN AI CLASSROOM</span>
            <p class="nh-sidebar-cta-text">
              Run live classes with real-time voice translation in 10+ languages, automated notes & sovereign video meetings.
            </p>
            <a href="https://login.ollasync.com" target="_blank" rel="noopener" class="nh-sidebar-cta-btn">
              Start Free Trial →
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>



