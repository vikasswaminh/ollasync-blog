---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-nh">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Ollasync Blog Home">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="ollamark-footer" x1="12" y1="3.5" x2="12" y2="20.5" gradientUnits="userSpaceOnUse">
                <stop stop-color="#4AA6FF"></stop>
                <stop offset="1" stop-color="#2F79F0"></stop>
              </linearGradient>
            </defs>
            <g stroke="url(#ollamark-footer)" stroke-width="3.4" fill="none">
              <path d="M6.605 6.790 A7.5 7.5 0 1 0 17.828 16.720"></path>
              <path d="M18.429 15.863 A7.5 7.5 0 0 0 7.280 6.172"></path>
            </g>
          </svg>
          <span>{SITE.brand}</span>
        </a>

        <p>
          Real-time AI voice translation, automated meeting notes, and seamless classroom synchronization.
        </p>
        <div class="footer-badges">
          <span class="badge-pill">10+ Languages</span>
          <span class="badge-pill">AI Class Notes</span>
          <span class="badge-pill">Browser Native</span>
        </div>
      </div>

      <div class="footer-col">
        <h4>Product</h4>
        <ul>
          <li><a href={`${SITE.marketingUrl}/#product`}>AI Classroom</a></li>
          <li><a href={`${SITE.marketingUrl}/#translation`}>Live Translation</a></li>
          <li><a href={`${SITE.marketingUrl}/#for-trainers`}>For Trainers</a></li>
          <li><a href={`${SITE.marketingUrl}/pricing`}>Pricing</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Blog Topics</h4>
        <ul>
          <li><a href="/">Latest Articles</a></li>
          <li><a href="/tags/guides/">Guides & Tutorials</a></li>
          <li><a href="/tags/announcements/">Product News</a></li>
          <li><a href="/tags/">All Tags</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about/">About OllaSync</a></li>
          <li><a href="/rss.xml">RSS Feed</a></li>
          <li><a href={SITE.marketingUrl} target="_blank" rel="noopener">ollasync.com ↗</a></li>
          <li><a href="https://networkershome.com" target="_blank" rel="noopener">Networkers Home ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.brand}. An AI Classroom for Trainers & Tutors.</span>
      <span class="mono" style="font-size: 11px;">Powered by Networkers Home Ecosystem</span>
    </div>
  </div>
</footer>


