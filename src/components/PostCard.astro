---
import FormattedDate from './FormattedDate.astro';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: number;
  author?: string;
}
const { url, title, description, pubDate, tags = [], minutes, author = 'OllaSync Team' } = Astro.props;
const tagString = tags.join(' ');
---

<article class="stream-card" data-tags={tagString}>
  <h2 class="stream-card-title">
    <a href={url}>{title}</a>
  </h2>
  <div class="stream-card-meta">
    <FormattedDate date={pubDate} />
    {minutes ? <span>·</span> : null}
    {minutes ? <span>{minutes} min read</span> : null}
    <span>·</span>
    <span>By {author}</span>
  </div>
  <p class="stream-card-desc">{description}</p>
  {
    tags.length > 0 && (
      <div class="stream-card-tags">
        {tags.map((t) => (
          <a class="tag" href={`/tags/${t}/`}>
            #{t}
          </a>
        ))}
      </div>
    )
  }
</article>


