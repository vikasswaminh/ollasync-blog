---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container-nh header-inner">
    <a class="brand" href="/" aria-label="Ollasync Blog Home">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="ollamark-header" x1="12" y1="3.5" x2="12" y2="20.5" gradientUnits="userSpaceOnUse">
            <stop stop-color="#4AA6FF"></stop>
            <stop offset="1" stop-color="#2F79F0"></stop>
          </linearGradient>
        </defs>
        <g stroke="url(#ollamark-header)" stroke-width="3.4" fill="none">
          <path d="M6.605 6.790 A7.5 7.5 0 1 0 17.828 16.720"></path>
          <path d="M18.429 15.863 A7.5 7.5 0 0 0 7.280 6.172"></path>
        </g>
      </svg>
      <span>{SITE.brand}</span>
      <span class="brand-badge">Blog</span>
    </a>


    <nav class="nav" aria-label="Primary">
      <div class="nav-links">
        {
          NAV.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))
        }
      </div>
      <a class="btn-contact" href={SITE.marketingUrl} target="_blank" rel="noopener">
        Visit {SITE.brand} →
      </a>
    </nav>
  </div>
</header>


